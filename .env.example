# Job Beast environment template. Copy to .env (gitignored) and fill in.
# Never commit real values. Every variable below is OPTIONAL.

# SQLite database location (default: data/jobs.db, project-relative).
JOBBEAST_DB=data/jobs.db

# Which candidate profile to use: a directory name under profiles/
# (default: the fictional "example" profile). Or set JOBBEAST_PROFILE_DIR to an
# absolute path that lives outside the repository.
JOBBEAST_PROFILE=example
# JOBBEAST_PROFILE_DIR=/path/to/your/private/profile

# OPTIONAL LinkedIn discovery via Apify (fetch-linkedin / watch --sources linkedin).
# Use your own Apify account token. Never supply LinkedIn cookies or credentials.
APIFY_TOKEN=your_apify_token_here

# OPTIONAL OpenAI-compatible LLM gateway (see docs/OMNIROUTE.md).
JOBBEAST_LLM_BASE_URL=http://localhost:20128/v1
JOBBEAST_LLM_API_KEY=your_llm_api_key_here
JOBBEAST_LLM_MODEL=jobbeast
